---
/** Temporary screen body until the bolt that builds the screen replaces it. */
interface Props {
  title: string;
  body: string;
  screenId: string;
}
const { title, body, screenId } = Astro.props;
import Card from './kit/Card.astro';
---
<section data-screen={screenId} class="space-y-4">
  <h1 class="text-2xl font-semibold leading-snug">{title}</h1>
  <Card variant="muted"><p class="text-muted-foreground">{body}</p></Card>
</section>
