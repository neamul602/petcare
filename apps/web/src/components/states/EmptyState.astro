---
/** Empty list or first-use state (page spec 5.12): says what is missing and offers the next step. Never invents content. */
import Button from '../kit/Button.astro';
import Card from '../kit/Card.astro';
interface Props {
  title: string;
  body?: string;
  actionLabel?: string;
  actionHref?: string;
}
const { title, body, actionLabel, actionHref } = Astro.props;
---
<Card variant="muted" class="space-y-3 text-center" data-state="empty">
  <h2 class="text-xl font-semibold">{title}</h2>
  {body && <p class="text-muted-foreground">{body}</p>}
  {actionLabel && actionHref && <div class="pt-1"><Button href={actionHref}>{actionLabel}</Button></div>}
</Card>
