---
/**
 * Error pattern (page spec 5.11): plain words, what the person can do next, never blame, no "sorry".
 * Variants: network, server, permission, offline. (Not-found is the 404 page.)
 */
import { t, ta, type Locale, type MessageKey } from '@petcare/shared/i18n';
import Button from '../kit/Button.astro';
import Card from '../kit/Card.astro';

type Variant = 'network' | 'server' | 'permission' | 'offline';
interface Props {
  variant: Variant;
  locale: Locale;
  /** Admin screens are English only. */
  admin?: boolean;
  actionHref?: string;
}
const { variant, locale, admin = false, actionHref } = Astro.props;
const text = (key: string) => (admin ? ta(key as never) : t(locale, key as MessageKey));
const hasOwnAction = variant === 'permission';
const href = actionHref ?? (hasOwnAction ? (admin ? '/admin/sign-in' : '/sign-in') : Astro.url.pathname);
const action = text(hasOwnAction ? 'error.permission.action' : 'state.retry');
const glyph = { network: '⌁', server: '!', permission: '⚿', offline: '○' }[variant];
---
<Card variant="muted" class="space-y-3 text-center" data-state="error" data-variant={variant} role="alert">
  <div aria-hidden="true" class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-warning-soft text-2xl text-warning">{glyph}</div>
  <h2 class="text-xl font-semibold">{text(`error.${variant}.title`)}</h2>
  <p class="text-muted-foreground">{text(`error.${variant}.body`)}</p>
  <div class="pt-1"><Button href={href}>{action}</Button></div>
</Card>
