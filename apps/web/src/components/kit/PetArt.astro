---
/** Friendly decorative illustration for hero panels: a dog and a cat peeking over a rounded hill. Purely decorative. */
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<svg class={className} viewBox="0 0 480 400" role="presentation" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <circle cx="240" cy="200" r="190" fill="hsl(150 22% 92%)" />
  <circle cx="380" cy="80" r="34" fill="hsl(36 78% 80%)" />
  <circle cx="90" cy="110" r="14" fill="hsl(14 70% 90%)" /><circle cx="420" cy="250" r="10" fill="hsl(14 70% 84%)" />
  <path d="M20 400 Q240 250 460 400 Z" fill="hsl(150 32% 32%)" />
  <path d="M60 400 Q240 290 420 400 Z" fill="hsl(150 38% 26%)" />
  <!-- dog -->
  <g transform="translate(110 130)">
    <ellipse cx="62" cy="120" rx="64" ry="56" fill="hsl(30 60% 62%)" />
    <path d="M10 40 Q-18 80 10 120 Q34 100 36 60 Z" fill="hsl(24 48% 40%)" />
    <path d="M114 40 Q142 80 114 120 Q90 100 88 60 Z" fill="hsl(24 48% 40%)" />
    <ellipse cx="62" cy="76" rx="52" ry="48" fill="hsl(30 60% 66%)" />
    <ellipse cx="62" cy="96" rx="26" ry="20" fill="hsl(38 60% 90%)" />
    <ellipse cx="62" cy="88" rx="9" ry="6" fill="hsl(30 12% 14%)" />
    <circle cx="42" cy="68" r="6" fill="hsl(30 12% 14%)" /><circle cx="82" cy="68" r="6" fill="hsl(30 12% 14%)" />
    <path d="M52 106 Q62 114 72 106" stroke="hsl(30 12% 14%)" stroke-width="3" fill="none" stroke-linecap="round" />
  </g>
  <!-- cat -->
  <g transform="translate(270 160)">
    <path d="M14 30 L30 -14 L56 22 Z" fill="hsl(14 64% 46%)" /><path d="M116 30 L100 -14 L74 22 Z" fill="hsl(14 64% 46%)" />
    <ellipse cx="65" cy="76" rx="56" ry="48" fill="hsl(14 70% 62%)" />
    <ellipse cx="65" cy="92" rx="22" ry="16" fill="hsl(38 60% 92%)" />
    <path d="M60 86 L70 86 L65 94 Z" fill="hsl(14 64% 40%)" />
    <ellipse cx="44" cy="66" rx="6" ry="8" fill="hsl(30 12% 14%)" /><ellipse cx="86" cy="66" rx="6" ry="8" fill="hsl(30 12% 14%)" />
    <path d="M8 84 H34 M8 96 H34 M96 84 H122 M96 96 H122" stroke="hsl(30 12% 14%)" stroke-width="2" stroke-linecap="round" />
  </g>
  <!-- paws -->
  <g fill="hsl(38 35% 97%)" opacity="0.9"><circle cx="60" cy="330" r="7" /><circle cx="80" cy="322" r="7" /><circle cx="100" cy="330" r="7" /><ellipse cx="80" cy="346" rx="15" ry="11" /></g>
</svg>
