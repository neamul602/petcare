---
/**
 * Bottom commit bar (DESIGN.md sticky-action-bar): optional summary, one primary action,
 * optional secondary link. Sits above the mobile tab bar.
 */
interface Props {
  class?: string;
}
const { class: extra = '' } = Astro.props;
---
<div class={`sticky bottom-0 z-10 flex items-center gap-4 border-t border-border bg-background/95 px-5 py-4 backdrop-blur ${extra}`}>
  <div class="min-w-0 flex-1 text-sm font-medium tabular-nums"><slot name="summary" /></div>
  <slot name="secondary" />
  <slot />
</div>
