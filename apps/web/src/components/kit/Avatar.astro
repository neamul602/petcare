---
/** A round avatar: the photo when there is one, otherwise the first letter on a soft colour chosen from the name. */
interface Props {
  name: string;
  src?: string | null;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}
const { name, src = null, size = 'md', class: extra = '' } = Astro.props;
const sizes = { sm: 'h-10 w-10 text-base', md: 'h-14 w-14 text-xl', lg: 'h-20 w-20 text-3xl', xl: 'h-28 w-28 text-4xl' };
const tones = [
  'bg-primary-soft text-primary-soft-foreground',
  'bg-info-soft text-info',
  'bg-warning-soft text-warning',
  'bg-accent-soft text-accent-soft-foreground',
  'bg-muted text-foreground',
];
const tone = tones[[...name].reduce((sum, ch) => sum + ch.charCodeAt(0), 0) % tones.length];
---
{src
  ? <img src={src} alt="" class={`${sizes[size]} shrink-0 rounded-full object-cover ring-2 ring-card ${extra}`} />
  : <span aria-hidden="true" class={`${sizes[size]} ${tone} inline-flex shrink-0 items-center justify-center rounded-full font-serif font-semibold ${extra}`}>{name.slice(0, 1)}</span>}
