---
/** Search entry (home for owners, and /search): neighbourhood, dates and pet. A plain GET form. */
import { platformRules } from '@petcare/shared/config';
import { t, type Locale, type MessageKey } from '@petcare/shared/i18n';
import Button from './kit/Button.astro';
import { addDays, todayInDhaka } from '@/lib/dates';
interface Props { locale: Locale; from?: string; to?: string; species?: string; area?: string }
const { locale, from = '', to = '', species = 'dog', area = '' } = Astro.props;
const today = todayInDhaka();
const L = (key: string) => t(locale, key as MessageKey);
const field = 'h-12 w-full rounded-md border border-border bg-input px-4 text-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2';
---
<form method="get" action="/search" class="space-y-4" data-testid="search-form">
  <div class="space-y-2">
    <label for="area" class="block text-sm font-medium">{L('search.area')}</label>
    <select id="area" name="area" class={field}>
      <option value="" selected={area === ''}>{L('search.area.any')}</option>
      {platformRules.launchNeighbourhoods.map((id) => <option value={id} selected={area === id}>{L(`neighbourhood.${id}`)}</option>)}
    </select>
  </div>
  <div class="grid grid-cols-2 gap-3">
    <div class="space-y-2"><label for="from" class="block text-sm font-medium">{L('search.from')}</label><input id="from" name="from" type="date" required min={today} value={from} class={field} /></div>
    <div class="space-y-2"><label for="to" class="block text-sm font-medium">{L('search.to')}</label><input id="to" name="to" type="date" required min={addDays(today, 1)} value={to} class={field} /></div>
  </div>
  <div class="space-y-2">
    <label for="species" class="block text-sm font-medium">{L('search.species')}</label>
    <select id="species" name="species" class={field}>
      <option value="dog" selected={species === 'dog'}>{L('pets.species.dog')}</option>
      <option value="cat" selected={species === 'cat'}>{L('pets.species.cat')}</option>
    </select>
  </div>
  <Button type="submit" class="w-full" data-testid="search-submit">{L('search.submit')}</Button>
</form>
