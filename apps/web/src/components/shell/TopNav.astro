---
/** Header navigation for owner and provider on tablets and desktops (same tabs as the tab bar). */
import type { Tab } from './TabBar.astro';
interface Props {
  tabs: Tab[];
  current: string;
  label: string;
}
const { tabs, current, label } = Astro.props;
const isActive = (href: string) => (href === '/' || href === '/provider' ? current === href : current === href || current.startsWith(`${href}/`));
---
<nav aria-label={label} class="hidden md:block" data-testid="top-nav">
  <ul class="flex gap-1">
    {tabs.map((tab) => (
      <li>
        <a href={tab.href} aria-current={isActive(tab.href) ? 'page' : undefined}
          class={`inline-flex min-h-11 items-center rounded-md px-3 font-medium hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring ${isActive(tab.href) ? 'text-primary' : 'text-foreground'}`}>
          {tab.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
