---
/** Provider app shell: same structure as the owner shell with the provider tabs (blueprint §2). */
import { t, type MessageKey } from '@petcare/shared/i18n';
import LanguageToggle from '../components/shell/LanguageToggle.astro';
import Logo from '../components/kit/Logo.astro';
import TabBar from '../components/shell/TabBar.astro';
import TopNav from '../components/shell/TopNav.astro';
import { getLocale } from '../lib/locale';
import BaseLayout from './BaseLayout.astro';

interface Props {
  titleKey: MessageKey;
}
const { titleKey } = Astro.props;
const locale = getLocale(Astro.cookies);
const current = Astro.url.pathname;
const tabs = [
  { href: '/provider', label: t(locale, 'nav.today') },
  { href: '/provider/calendar', label: t(locale, 'nav.calendar') },
  { href: '/provider/bookings', label: t(locale, 'nav.bookings') },
  { href: '/provider/earnings', label: t(locale, 'nav.earnings') },
  { href: '/provider/profile', label: t(locale, 'nav.profile') },
];
---
<BaseLayout title={`${t(locale, titleKey)} · ${t(locale, 'app.name')}`} lang={locale} skipLabel={t(locale, 'a11y.skipToContent')} offlineMessage={t(locale, 'banner.offline')}>
  <div data-shell="provider">
    <header class="sticky top-0 z-20 border-b border-border bg-background">
      <div class="mx-auto flex max-w-6xl items-center gap-2 px-3 py-2 sm:gap-3 sm:px-6">
        <a href="/provider" class="mr-auto inline-flex min-h-11 items-center gap-2 text-primary"><Logo />
        </a>
        <TopNav tabs={tabs} current={current} label={t(locale, 'a11y.mainNav')} />
        <LanguageToggle locale={locale} current={current} />
        <a href="/provider/inbox" class="inline-flex min-h-11 items-center rounded-md px-2 text-sm font-medium hover:bg-muted sm:px-3">{t(locale, 'nav.inbox')}</a>
        <a href="/provider/settings" class="inline-flex min-h-11 items-center rounded-md px-2 text-sm font-medium hover:bg-muted sm:px-3">{t(locale, 'nav.settings')}</a>
      </div>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-4 py-6 pb-24 sm:px-6 md:pb-6">
      <slot />
    </main>
    <TabBar tabs={tabs} current={current} label={t(locale, 'a11y.mainNav')} />
  </div>
</BaseLayout>
