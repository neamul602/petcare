---
/** Owner app shell: header (brand, desktop nav, language, settings) and bottom tab bar (blueprint §2). */
import { t, type MessageKey } from '@petcare/shared/i18n';
import LanguageToggle from '../components/shell/LanguageToggle.astro';
import TabBar from '../components/shell/TabBar.astro';
import TopNav from '../components/shell/TopNav.astro';
import { getLocale } from '../lib/locale';
import BaseLayout from './BaseLayout.astro';

interface Props {
  titleKey: MessageKey;
  showTabs?: boolean;
}
const { titleKey, showTabs = true } = Astro.props;
const locale = getLocale(Astro.cookies);
const current = Astro.url.pathname;
const tabs = [
  { href: '/', label: t(locale, 'nav.home') },
  { href: '/bookings', label: t(locale, 'nav.bookings') },
  { href: '/pets', label: t(locale, 'nav.pets') },
  { href: '/inbox', label: t(locale, 'nav.inbox') },
];
---
<BaseLayout title={`${t(locale, titleKey)} · ${t(locale, 'app.name')}`} lang={locale} skipLabel={t(locale, 'a11y.skipToContent')}>
  <div data-shell="owner">
    <header class="sticky top-0 z-20 border-b border-border bg-background/95 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center gap-3 px-4 py-2 sm:px-6">
        <a href="/" class="mr-auto inline-flex min-h-11 items-center font-serif text-xl font-semibold text-primary">{t(locale, 'app.name')}</a>
        {showTabs && <TopNav tabs={tabs} current={current} label={t(locale, 'a11y.mainNav')} />}
        <LanguageToggle locale={locale} current={current} />
        {showTabs && <a href="/settings" class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium hover:bg-muted">{t(locale, 'nav.settings')}</a>}
      </div>
    </header>
    <main id="main" class={`mx-auto max-w-5xl px-4 py-6 sm:px-6 ${showTabs ? 'pb-24 md:pb-6' : ''}`}>
      <slot />
    </main>
    {showTabs && <TabBar tabs={tabs} current={current} label={t(locale, 'a11y.mainNav')} />}
  </div>
</BaseLayout>
