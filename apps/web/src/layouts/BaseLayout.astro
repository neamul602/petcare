---
/** Document shell: language, fonts, design tokens and the skip link (every page). */
import '../styles/fonts.css';
import '../styles/tokens.css';
import ConnectivityBanner from '../components/shell/ConnectivityBanner.tsx';

interface Props {
  title: string;
  lang: 'bn' | 'en';
  skipLabel: string;
  offlineMessage: string;
}
const { title, lang, skipLabel, offlineMessage } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#376c52" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-card focus:px-4 focus:py-2 focus:shadow-lg">{skipLabel}</a>
    <ConnectivityBanner client:load message={offlineMessage} />
    <slot />
    <script>
      import '../scripts/persist-forms.ts';
      import '../scripts/register-sw.ts';
    </script>
  </body>
</html>
