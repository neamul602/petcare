---
/** Admin console shell: English only, no language toggle, left sidebar that becomes a menu below 768 px. */
import { ta, type AdminMessageKey } from '@petcare/shared/i18n';
import AdminMenu from '../components/shell/AdminMenu.tsx';
import Button from '../components/kit/Button.astro';
import Logo from '../components/kit/Logo.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  titleKey: AdminMessageKey;
  bare?: boolean;
}
const { titleKey, bare = false } = Astro.props;
const current = Astro.url.pathname;
const admin = Astro.locals.admin;
const items = [
  { href: '/admin', label: ta('nav.queue') },
  { href: '/admin/providers', label: ta('nav.providers') },
  { href: '/admin/reviews', label: ta('nav.reviews') },
  { href: '/admin/payouts', label: ta('nav.payouts') },
  { href: '/admin/insights', label: ta('nav.insights') },
  { href: '/admin/audit', label: ta('nav.audit') },
  { href: '/admin/users', label: 'Users & admins' },
].map((item) => ({
  ...item,
  active: item.href === '/admin' ? current === '/admin' || current.startsWith('/admin/acute') || current.startsWith('/admin/reports') : current === item.href || current.startsWith(`${item.href}/`),
}));
---
<BaseLayout title={`${ta(titleKey)} · ${ta('app.name')}`} lang="en" skipLabel={ta('a11y.skipToContent')} offlineMessage={ta('banner.offline')}>
  <div data-shell="admin" class="min-h-dvh md:flex">
    {!bare && (
      <aside class="sticky top-0 hidden h-dvh w-60 shrink-0 flex-col overflow-y-auto border-r border-border bg-card md:flex">
        <div class="px-6 py-6"><Logo /><p class="eyebrow mt-2 text-muted-foreground">Admin console</p></div>
        <nav aria-label={ta('a11y.adminNav')} data-testid="admin-sidebar" class="flex-1">
          <ul class="space-y-2 px-3">
            {items.map((item) => (
              <li>
                <a href={item.href} aria-current={item.active ? 'page' : undefined}
                  class={`flex min-h-10 items-center rounded-md px-3 font-medium text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring ${item.active ? 'bg-primary-soft !text-primary-soft-foreground' : ''}`}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        {admin && (
          <div class="space-y-3 border-t border-border p-5" data-testid="admin-account">
            <p class="text-sm font-medium" data-testid="signed-in-as">{ta('nav.signedInAs', { name: admin.name })}</p>
            <form method="post" action="/admin/sign-out"><Button type="submit" variant="outline" size="sm" data-testid="sign-out">{ta('nav.signOut')}</Button></form>
          </div>
        )}
      </aside>
    )}
    <div class="min-w-0 flex-1">
      <header class="relative flex items-center gap-3 border-b border-border bg-background px-4 py-2 md:hidden">
        <span class="mr-auto"><Logo size={32} /></span>
        {admin && !bare && <form method="post" action="/admin/sign-out"><Button type="submit" variant="outline" size="sm" data-testid="sign-out-mobile">{ta('nav.signOut')}</Button></form>}
        {!bare && <AdminMenu client:load items={items} menuLabel={ta('nav.menu')} navLabel={ta('a11y.adminNav')} />}
      </header>
      <main id="main" class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>
