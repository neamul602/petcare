---
import { t } from '@petcare/shared/i18n';
import SearchForm from '@/components/SearchForm.astro';
import Avatar from '@/components/kit/Avatar.astro';
import Button from '@/components/kit/Button.astro';
import Card from '@/components/kit/Card.astro';
import OwnerShell from '@/layouts/OwnerShell.astro';
import { addDays, todayInDhaka } from '@/lib/dates';
import { formatMoney } from '@petcare/shared/locale';
import { apiFetch } from '@/lib/api';
import { getLocale } from '@/lib/locale';
const locale = getLocale(Astro.cookies);
const isOwner = Astro.locals.user?.role === 'owner';
const cookie = Astro.request.headers.get('cookie');
let latest: any = null;
let pets: Array<{ id: string; name: string; breed: string; photo: string | null }> = [];
if (isOwner) {
  const list = await apiFetch('/owner/bookings', { cookie }).then((r) => (r.ok ? r.json() : null)).catch(() => null);
  latest = (list?.past ?? []).find((b: any) => b.canBookAgain) ?? null;
  const mine = await apiFetch('/owner/pets', { cookie }).then((r) => (r.ok ? r.json() : null)).catch(() => null);
  pets = mine?.pets ?? [];
}
let featured: Array<{ slug: string; name: { en: string; bn: string }; tier: string; area: string; pricePerNightPoisha: number | null }> = [];
const start = addDays(todayInDhaka(), 7);
const found = await apiFetch(`/search?${new URLSearchParams({ from: start, to: addDays(start, 2), species: 'dog', all: '1' })}`).then((r) => (r.ok ? r.json() : null)).catch(() => null);
featured = (found?.providers ?? []).slice(0, 3);
const why = ['vetted', 'care', 'safe'] as const;
---
<OwnerShell titleKey="screen.home">
  <div class="space-y-20 py-6">
    <section class="grid items-start gap-12 md:grid-cols-[1.2fr_1fr]">
      <div class="space-y-6 pt-4">
        <p class="eyebrow text-muted-foreground">{t(locale, 'home.hero.badge')}</p>
        <h1 class="text-5xl font-semibold leading-[1.08] md:text-6xl">{t(locale, 'home.promise.title')}</h1>
        <p class="max-w-xl text-lg leading-relaxed text-muted-foreground">{t(locale, 'home.promise.body')}</p>
        {!isOwner && (
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <Button href="/search" size="lg" data-testid="find-care">{t(locale, 'home.cta')}</Button>
            {!Astro.locals.user && <a href="/sign-up" class="font-medium text-primary underline underline-offset-4">{t(locale, 'home.hero.signup')}</a>}
          </div>
        )}
      </div>
      {isOwner
        ? <Card variant="elevated"><SearchForm locale={locale} /></Card>
        : (
          <Card class="divide-y divide-border !p-0">
            {why.map((k, i) => (
              <div class="flex gap-5 p-6"><span class="font-serif text-3xl text-primary">0{i + 1}</span>
                <div><p class="text-lg font-semibold">{t(locale, `home.why.${k}` as 'home.why.vetted')}</p><p class="mt-1 text-muted-foreground">{t(locale, `home.why.${k}.body` as 'home.why.vetted.body')}</p></div></div>
            ))}
          </Card>
        )}
    </section>

    {latest && (
      <Card class="flex flex-wrap items-center gap-4" data-testid="home-book-again">
        <Avatar name={latest.provider.name[locale]} size="md" />
        <p class="mr-auto text-lg font-semibold">{t(locale, 'home.again.title', { name: latest.provider.name[locale], pet: latest.pet.name })}</p>
        <form method="post" action={`/bookings/${latest.id}/act`}><input type="hidden" name="intent" value="book-again" /><Button type="submit" data-testid="home-book-again-button">{t(locale, 'booking.again')}</Button></form>
      </Card>
    )}

    {isOwner && (
      <section class="space-y-5" data-testid="home-pets">
        <div class="flex items-center justify-between"><h2 class="text-3xl font-semibold">{t(locale, 'home.pets.title')}</h2><Button href="/pets/new" variant="outline" size="sm">{t(locale, 'home.pets.add')}</Button></div>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {pets.map((pet) => (
            <li><a href={`/pets/${pet.id}`} class="link-card block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><Card class="flex items-center gap-4 !p-4"><Avatar name={pet.name} src={pet.photo} size="md" /><span><span class="block text-lg font-semibold">{pet.name}</span><span class="block text-sm text-muted-foreground">{pet.breed}</span></span></Card></a></li>
          ))}
        </ul>
      </section>
    )}

    <section>
      <h2 class="mb-8 text-3xl font-semibold">{t(locale, 'home.how.title')}</h2>
      <ol class="grid gap-10 md:grid-cols-3">
        {(['home.how.1', 'home.how.2', 'home.how.3'] as const).map((key, i) => (
          <li class="border-t-2 border-foreground pt-5"><span class="font-serif text-5xl text-primary">0{i + 1}</span><p class="mt-4 text-xl leading-snug">{t(locale, key)}</p></li>
        ))}
      </ol>
    </section>

    {featured.length > 0 && (
      <section class="space-y-6" data-testid="home-featured">
        <div class="flex items-end justify-between border-b border-border pb-4"><h2 class="text-3xl font-semibold">{t(locale, 'home.featured.title')}</h2><a href="/search" class="font-medium text-primary underline-offset-4 hover:underline">{t(locale, 'home.featured.all')}</a></div>
        <ul class="grid gap-5 md:grid-cols-3">
          {featured.map((p) => (
            <li><a href={`/providers/${p.slug}`} class="link-card block h-full rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
              <Card class="flex h-full items-center gap-4 !p-5">
                <Avatar name={p.name[locale]} size="lg" />
                <div class="min-w-0">
                  <p class="text-lg font-semibold">{p.name[locale]}</p>
                  <p class="text-sm text-muted-foreground">{t(locale, `neighbourhood.${p.area}` as 'neighbourhood.gulshan')}</p>
                  {p.pricePerNightPoisha != null && <p class="mt-2 font-medium">{t(locale, 'provider.price', { price: formatMoney(p.pricePerNightPoisha) })}</p>}
                </div>
              </Card>
            </a></li>
          ))}
        </ul>
      </section>
    )}

    {!Astro.locals.user && (
      <section class="grid items-center gap-6 rounded-xl bg-primary p-10 text-primary-foreground md:grid-cols-[1fr_auto] md:p-14" data-testid="home-host-cta">
        <div class="max-w-2xl space-y-3"><h2 class="text-3xl font-semibold md:text-4xl">{t(locale, 'home.host.title')}</h2><p class="text-lg text-primary-soft">{t(locale, 'home.host.body')}</p></div>
        <a href="/sign-up" class="inline-flex h-12 items-center rounded-lg bg-background px-6 text-lg font-medium text-primary hover:bg-card">{t(locale, 'home.host.cta')}</a>
      </section>
    )}
  </div>
</OwnerShell>
