---
import PageHeader from '@/components/kit/PageHeader.astro';
import { t } from '@petcare/shared/i18n';
import PetForm from '@/components/pets/PetForm';
import OwnerShell from '@/layouts/OwnerShell.astro';
import { apiFetch } from '@/lib/api';
import { getLocale } from '@/lib/locale';
import { petText } from '@/lib/pets';
const locale = getLocale(Astro.cookies);
const response = await apiFetch(`/owner/pets/${Astro.params.id}`, { cookie: Astro.request.headers.get('cookie') }).catch(() => null);
if (!response || response.status === 404) return Astro.rewrite('/404');
if (!response.ok) return Astro.redirect('/pets');
const { pet } = (await response.json()) as { pet: { id: string; name: string } & Record<string, unknown> };
---
<OwnerShell titleKey="screen.petEdit">
  <div class="space-y-4 py-4">
    <PageHeader title={`${t(locale, 'screen.petEdit')}: ${pet.name}`} />
    <PetForm client:load mode="edit" pet={pet as never} text={petText(locale)} />
  </div>
</OwnerShell>
