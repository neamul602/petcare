---
import { t } from '@petcare/shared/i18n';
import Placeholder from '@/components/Placeholder.astro';
import ProviderShell from '@/layouts/ProviderShell.astro';
import { getLocale } from '@/lib/locale';
const locale = getLocale(Astro.cookies);
---
<ProviderShell titleKey="screen.today">
  <Placeholder screenId="P1" title={t(locale, 'screen.today')} body={t(locale, 'placeholder.body')} />
</ProviderShell>
