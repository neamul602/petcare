---
import PageHeader from '@/components/kit/PageHeader.astro';
import { t } from '@petcare/shared/i18n';
import { formatDate, formatMoney } from '@petcare/shared/locale';
import Avatar from '@/components/kit/Avatar.astro';
import Button from '@/components/kit/Button.astro';
import Card from '@/components/kit/Card.astro';
import StatePill from '@/components/kit/StatePill.astro';
import EmptyState from '@/components/states/EmptyState.astro';
import OwnerShell from '@/layouts/OwnerShell.astro';
import { apiFetch } from '@/lib/api';
import { getLocale } from '@/lib/locale';
const locale = getLocale(Astro.cookies);
const response = await apiFetch('/owner/bookings', { cookie: Astro.request.headers.get('cookie') }).catch(() => null);
const data = response?.ok ? ((await response.json()) as { upcoming: any[]; past: any[] }) : { upcoming: [], past: [] };
const day = (d: string) => formatDate(new Date(`${d}T00:00:00+06:00`), locale);
const groups = [['upcoming', data.upcoming], ['past', data.past]] as const;
---
<OwnerShell titleKey="screen.bookings">
  <div class="space-y-6 py-4">
    <PageHeader title={t(locale, 'screen.bookings')} />
    {data.upcoming.length === 0 && data.past.length === 0 && (
      <EmptyState title={t(locale, 'bookings.empty.title')} body={t(locale, 'bookings.empty.body')} actionLabel={t(locale, 'home.cta')} actionHref="/search" />
    )}
    {groups.map(([key, list]) => list.length > 0 && (
      <section class="space-y-3" data-testid={`group-${key}`}>
        <h2 class="text-xl font-semibold">{t(locale, `bookings.${key}` as 'bookings.upcoming')}</h2>
        <ul class="grid gap-4 lg:grid-cols-2">
          {list.map((b: any) => (
            <li>
              <Card class="flex h-full flex-col gap-3 !p-5" data-testid="booking-row">
                <a href={`/bookings/${b.id}`} class="flex items-center gap-4 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                  <Avatar name={b.provider.name[locale]} size="md" />
                  <span class="min-w-0 flex-1">
                    <span class="flex flex-wrap items-center gap-2"><span class="mr-auto text-lg font-semibold">{b.provider.name[locale]} · {b.pet.name}</span><StatePill state={b.pill} label={t(locale, `booking.state.${b.state}` as 'booking.state.authorized')} /></span>
                    <span class="mt-1 block text-muted-foreground">{t(locale, 'booking.dates', { from: day(b.startDate), to: day(b.endDate), n: b.nights })}</span>
                    <span class="mt-1 block font-serif text-xl font-semibold text-primary">{formatMoney(b.totalPoisha)}</span>
                  </span>
                </a>
                {b.canBookAgain && (
                  <form method="post" action={`/bookings/${b.id}/act`}>
                    <input type="hidden" name="intent" value="book-again" />
                    <Button type="submit" variant="secondary" data-testid="book-again">{t(locale, 'booking.again')}</Button>
                  </form>
                )}
              </Card>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</OwnerShell>
