---
import { trainingDecisions } from '@petcare/shared/config';
import { t, type MessageKey } from '@petcare/shared/i18n';
import { formatDate, formatMoney, formatTime } from '@petcare/shared/locale';
import Button from '@/components/kit/Button.astro';
import Card from '@/components/kit/Card.astro';
import StatePill from '@/components/kit/StatePill.astro';
import OwnerShell from '@/layouts/OwnerShell.astro';
import { apiFetch } from '@/lib/api';
import UpdateList from '@/components/stay/UpdateList.astro';
import VetClinics from '@/components/stay/VetClinics.astro';
import { getLocale } from '@/lib/locale';
const locale = getLocale(Astro.cookies);
const L = (key: string, params?: Record<string, string | number>) => t(locale, key as MessageKey, params);
const response = await apiFetch(`/owner/bookings/${Astro.params.id}`, { cookie: Astro.request.headers.get('cookie') }).catch(() => null);
if (!response || response.status === 404) return Astro.rewrite('/404');
if (!response.ok) return Astro.redirect('/bookings');
const { booking: b, history, updates } = (await response.json()) as { booking: any; history: Array<{ to: string; at: string }>; updates: any[] };
const clinicsRes = ['captured', 'in_stay'].includes(b.state) ? await apiFetch(`/bookings/${Astro.params.id}/vet-clinics`, { cookie: Astro.request.headers.get('cookie') }).catch(() => null) : null;
const clinics = clinicsRes?.ok ? ((await clinicsRes.json()) as { clinics: any[] }).clinics : [];
const name: string = b.provider.name[locale];
const stayPhotos: Array<{ id: string; url: string }> = (updates ?? []).flatMap((u: any) => u.photos.map((url: string) => ({ id: url.split('/').pop()!, url })));
const day = (d: string) => formatDate(new Date(`${d}T00:00:00+06:00`), locale);
const when = (iso: string) => `${formatDate(new Date(iso), locale)} ${formatTime(new Date(iso), locale)}`;
const amount = formatMoney(b.totalPoisha);
const pending = Astro.url.searchParams.get('pending') === '1';
---
<OwnerShell titleKey="screen.booking">
  <div class="space-y-5 py-4">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="mr-auto text-2xl font-semibold" data-testid="booking-title">{b.state === 'authorized' ? L('booking.waiting', { name }) : name}</h1>
      <StatePill state={b.pill} label={L(`booking.state.${b.state}`)} />
    </div>
    <Card class="space-y-2">
      <p data-testid="booking-dates">{L('booking.dates', { from: day(b.startDate), to: day(b.endDate), n: b.nights })}</p>
      <p>{b.pet.name}</p>
      <p class="text-lg font-semibold" data-testid="booking-total">{amount}</p>
    </Card>

    {b.state === 'authorized' && (
      <Card class="space-y-3" data-testid="waiting">
        <p data-testid="deadline">{L('booking.deadline', { name, time: when(b.confirmationDeadline) })}</p>
        <p data-testid="hold">{L('booking.hold', { amount, name })}</p>
        <form method="post" action={`/bookings/${b.id}/cancel`} onsubmit={`return confirm(${JSON.stringify(L('booking.cancel.confirm'))})`}>
          <Button type="submit" variant="outline" data-testid="cancel-request">{L('booking.cancel')}</Button>
        </form>
      </Card>
    )}
    {b.state === 'captured' && <Card><p>{L('booking.captured.body', { name, amount })}</p></Card>}
    {b.acuteEvent && (
      <div role="status" data-testid="acute-banner" class="space-y-1 rounded-lg bg-accent p-5 text-accent-foreground">
        <p class="text-lg font-semibold">{L('acute.banner.title', { pet: b.pet.name })}</p>
        <p>{L('acute.banner.body', { name, type: L(`acute.type.${b.acuteEvent.type}`), severity: L(`acute.severity.${b.acuteEvent.severity}`), time: when(b.acuteEvent.at) })}</p>
        {(b.acuteEvent.messages ?? []).map((m: any) => <p data-testid="acute-message" class="border-t border-accent-foreground/30 pt-2">{m.text}</p>)}
      </div>
    )}
    {b.state === 'in_stay' && <Card><p>{L('stay.inStay.body', { name, pet: b.pet.name })}</p></Card>}
    {b.canConfirmCompletion && (
      <Card class="space-y-3" data-testid="confirm-completion-card">
        <p class="font-semibold">{L('booking.confirmCompletion.title', { name })}</p>
        <form method="post" action={`/bookings/${b.id}/act`}>
          <input type="hidden" name="intent" value="confirm-completion" />
          <Button type="submit" size="lg" class="w-full" data-testid="confirm-completion">{L('booking.confirmCompletion')}</Button>
        </form>
      </Card>
    )}
    {b.state === 'completed' && (
      <Card data-testid="completed" class="space-y-3">
        <p>{L('booking.completed.body')}</p>
        <form method="post" action={`/bookings/${b.id}/act`}><input type="hidden" name="intent" value="book-again" /><Button type="submit" variant="secondary" data-testid="book-again">{L('booking.again')}</Button></form>
      </Card>
    )}
    {b.review && (
      <Card data-testid="your-review" class="space-y-1">
        <p class="font-semibold">{L('review.yours')}: {b.review.rating}/5</p>
        {b.review.text && <p>{b.review.text}</p>}
        {b.review.removed && <p data-testid="review-removed" class="text-muted-foreground">{L('review.removed', { reason: L(`review.removedReason.${b.review.removedReason}`) })}</p>}
      </Card>
    )}
    {b.canReview && (
      <Card class="space-y-3" data-testid="review-card">
        <h2 class="text-xl font-semibold">{L('review.title')}</h2>
        <form method="post" action={`/bookings/${b.id}/act`} class="space-y-3">
          <input type="hidden" name="intent" value="review" />
          <label for="rating" class="block text-sm font-medium">{L('review.rating')}</label>
          <select id="rating" name="rating" required class="h-12 w-full rounded-md border border-border bg-input px-4 text-base" data-testid="review-rating">
            {[5, 4, 3, 2, 1].map((n) => <option value={n}>{n}</option>)}
          </select>
          <label for="review-text" class="block text-sm font-medium">{L('review.text')}</label>
          <textarea id="review-text" name="text" maxlength="1000" class="min-h-24 w-full rounded-md border border-border bg-input p-4 text-base" data-testid="review-text"></textarea>
          {stayPhotos.length > 0 && (
            <fieldset class="space-y-2"><legend class="text-sm font-medium">{L('review.photos')}</legend>
              <ul class="grid grid-cols-3 gap-2">{stayPhotos.slice(0, 12).map((p) => <li><label class="block space-y-1"><img src={p.url} alt="" class="aspect-square w-full rounded-md object-cover" /><span class="flex min-h-11 items-center gap-2"><input type="checkbox" name="photoIds" value={p.id} aria-label={L('review.selectPhoto')} class="h-5 w-5 accent-primary" data-testid="review-photo" /></span></label></li>)}</ul>
            </fieldset>
          )}
          <Button type="submit" data-testid="review-send">{L('review.send')}</Button>
        </form>
      </Card>
    )}
    {b.report && <Card data-testid="report-sent"><p>{L('report.sent')}</p></Card>}
    {b.canReport && (
      <details class="rounded-lg border border-border bg-card p-4" data-testid="report-sheet">
        <summary class="flex min-h-11 cursor-pointer items-center font-medium">{L('report.title')}</summary>
        <form method="post" action={`/bookings/${b.id}/act`} class="mt-3 space-y-3">
          <input type="hidden" name="intent" value="report" />
          <p class="text-sm text-muted-foreground">{L('report.closes', { time: when(b.reportClosesAt) })}</p>
          <label for="report-category" class="block text-sm font-medium">{L('report.category')}</label>
          <select id="report-category" name="category" required class="h-12 w-full rounded-md border border-border bg-input px-4 text-base" data-testid="report-category">
            {trainingDecisions.reportCategories.map((c) => <option value={c}>{L(`report.cat.${c}`)}</option>)}
          </select>
          <label for="report-description" class="block text-sm font-medium">{L('report.description')}</label>
          <textarea id="report-description" name="description" required minlength="3" maxlength="2000" class="min-h-24 w-full rounded-md border border-border bg-input p-4 text-base" data-testid="report-description"></textarea>
          {stayPhotos.length > 0 && (
            <fieldset class="space-y-2"><legend class="text-sm font-medium">{L('report.photos')}</legend>
              <ul class="grid grid-cols-3 gap-2">{stayPhotos.slice(0, 12).map((p) => <li><label class="block space-y-1"><img src={p.url} alt="" class="aspect-square w-full rounded-md object-cover" /><span class="flex min-h-11 items-center gap-2"><input type="checkbox" name="photoIds" value={p.id} aria-label={L('review.selectPhoto')} class="h-5 w-5 accent-primary" /></span></label></li>)}</ul>
            </fieldset>
          )}
          <Button type="submit" variant="outline" data-testid="report-send">{L('report.send')}</Button>
        </form>
      </details>
    )}
    {b.state === 'completed' && !b.canReport && !b.report && <p class="text-sm text-muted-foreground">{L('report.closed')}</p>}
    {b.state === 'no_show' && <Card data-testid="no-show"><p>{L('booking.noShow.body')}</p></Card>}
    {b.state === 'refunded' && <Card><p>{L('booking.refunded.body')}</p></Card>}
    {b.cancellationRequested && <Card data-testid="cancel-requested"><p>{L('booking.cancelRequested')}</p></Card>}
    {b.canRequestCancellation && (
      <details class="rounded-lg border border-border bg-card p-4" data-testid="request-cancel-sheet">
        <summary class="flex min-h-11 cursor-pointer items-center font-medium">{L('booking.requestCancel')}</summary>
        <form method="post" action={`/bookings/${b.id}/act`} class="mt-3 space-y-3">
          <input type="hidden" name="intent" value="request-cancellation" />
          <p class="text-sm text-muted-foreground">{L('booking.requestCancel.help')}</p>
          <label for="cancel-note" class="block text-sm font-medium">{L('booking.requestCancel.note')}</label>
          <input id="cancel-note" name="note" maxlength="300" class="h-12 w-full rounded-md border border-border bg-input px-4 text-base" />
          <Button type="submit" variant="outline" data-testid="request-cancel-send">{L('booking.requestCancel.send')}</Button>
        </form>
      </details>
    )}
    {['in_stay', 'completed'].includes(b.state) && <UpdateList locale={locale} updates={updates} />}
    {clinics.length > 0 && <VetClinics locale={locale} clinics={clinics} />}
    {b.state === 'declined' && (
      <Card class="space-y-3" data-testid="declined">
        <p>{L('booking.declined.body', { name })}</p>
        {b.declineReason && <p>{L('booking.declined.reason', { reason: L(`decline.${b.declineReason}`) })}</p>}
        <Button href="/search" variant="secondary">{L('booking.backToResults')}</Button>
      </Card>
    )}
    {b.state === 'canceled' && (
      <Card class="space-y-2" data-testid="canceled">
        <p>{b.timedOut ? L('booking.timedOut.body', { name }) : L('booking.canceled.body')}</p>
        {pending && <p>{L('booking.paymentPending')}</p>}
        <Button href="/search" variant="secondary">{L('booking.backToResults')}</Button>
      </Card>
    )}

    <section class="space-y-2">
      <h2 class="text-xl font-semibold">{L('booking.history')}</h2>
      <ul class="space-y-1 text-muted-foreground" data-testid="history">{history.map((h) => <li>{L('booking.history.entry', { time: when(h.at), state: L(`booking.state.${h.to}`) })}</li>)}</ul>
    </section>
  </div>
</OwnerShell>
