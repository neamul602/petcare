---
import Avatar from '@/components/kit/Avatar.astro';
import Badge from '@/components/kit/Badge.astro';
import Button from '@/components/kit/Button.astro';
import Card from '@/components/kit/Card.astro';
import AdminShell from '@/layouts/AdminShell.astro';
import { apiFetch } from '@/lib/api';
const cookie = Astro.request.headers.get('cookie');
const response = await apiFetch(`/admin/providers/${Astro.params.id}`, { cookie }).catch(() => null);
if (!response || response.status === 404) return Astro.rewrite('/404');
if (!response.ok) return Astro.redirect('/admin/providers');
const { provider, history } = (await response.json()) as { provider: any; history: any[] };
const status = provider.status as string;
const label = status === 'applied' || status === 'vetting' ? 'Pending' : status === 'approved' ? 'Approved' : status === 'suspended' ? 'Suspended' : 'Rejected';
const here = `/admin/providers/${provider.id}`;
const button = (intent: string, text: string, variant: 'primary' | 'outline', testid: string) => ({ intent, text, variant, testid });
const actions = [
  status !== 'approved' && button('approve', 'Approve', 'primary', 'approve'),
  ['applied', 'vetting', 'suspended'].includes(status) && button('reject', 'Reject', 'outline', 'reject'),
  status === 'approved' && button('suspend', 'Suspend', 'outline', 'suspend'),
].filter(Boolean) as ReturnType<typeof button>[];
---
<AdminShell titleKey="screen.providerDetail">
  <div class="space-y-6 py-4">
    <a href="/admin/providers" class="text-sm font-medium text-primary underline-offset-4 hover:underline">← All providers</a>
    <header class="flex flex-wrap items-center gap-5 border-b border-border pb-6">
      <Avatar name={provider.name.en} size="lg" />
      <div class="mr-auto">
        <h1 class="text-3xl font-semibold" data-testid="provider-name">{provider.name.en}</h1>
        <p class="text-muted-foreground">Tier {provider.tier}{provider.hasAccount ? '' : ' · no sign-in account yet'}</p>
      </div>
      <Badge variant={status === 'approved' ? 'verified' : status === 'suspended' || status === 'removed' ? 'warning' : 'info'}><span data-testid="provider-status">{label}</span></Badge>
      <div class="flex gap-2">
        {actions.map((a) => (
          <form method="post" action="/admin/providers/act"><input type="hidden" name="intent" value={a.intent} /><input type="hidden" name="id" value={provider.id} /><input type="hidden" name="from" value={here} /><Button type="submit" variant={a.variant} data-testid={a.testid}>{a.text}</Button></form>
        ))}
      </div>
    </header>
    {status === 'approved' && <a class="inline-flex min-h-11 items-center text-primary underline" href={`/providers/${provider.slug}`}>View public profile</a>}
    <Card class="space-y-3">
      <h2 class="text-xl font-semibold">History</h2>
      {history.length === 0 && <p class="text-muted-foreground">No changes yet.</p>}
      <ul class="space-y-2" data-testid="provider-history">{history.map((h) => <li>{h.from} → {h.to} — {h.reason}</li>)}</ul>
    </Card>
  </div>
</AdminShell>
