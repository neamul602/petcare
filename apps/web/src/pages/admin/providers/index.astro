---
import { ta } from '@petcare/shared/i18n';
import { t } from '@petcare/shared/i18n';
import PageHeader from '@/components/kit/PageHeader.astro';
import Avatar from '@/components/kit/Avatar.astro';
import Badge from '@/components/kit/Badge.astro';
import Button from '@/components/kit/Button.astro';
import Card from '@/components/kit/Card.astro';
import EmptyState from '@/components/states/EmptyState.astro';
import ErrorState from '@/components/states/ErrorState.astro';
import AdminShell from '@/layouts/AdminShell.astro';
import { apiFetch } from '@/lib/api';
interface Row { id: string; name: { en: string }; tier: 'A' | 'B'; status: string; neighbourhood: string }
const cookie = Astro.request.headers.get('cookie');
const filter = Astro.url.searchParams.get('show') ?? 'pending';
let all: Row[] = [];
let failed = false;
try {
  const response = await apiFetch('/admin/providers', { cookie });
  if (response.ok) all = ((await response.json()) as { providers: Row[] }).providers;
  else failed = true;
} catch {
  failed = true;
}
const groups: Record<string, (r: Row) => boolean> = {
  pending: (r) => r.status === 'applied' || r.status === 'vetting',
  approved: (r) => r.status === 'approved',
  inactive: (r) => r.status === 'suspended' || r.status === 'removed',
  all: () => true,
};
const rows = all.filter(groups[filter] ?? groups.pending!);
const count = (key: string) => all.filter(groups[key]!).length;
const tabs = [['pending', 'Pending approval'], ['approved', 'Approved'], ['inactive', 'Suspended / rejected'], ['all', 'All']] as const;
const statusText = (s: string) => (s === 'applied' || s === 'vetting' ? 'Pending' : s === 'approved' ? 'Approved' : s === 'suspended' ? 'Suspended' : 'Rejected');
const here = `/admin/providers?show=${filter}`;
---
<AdminShell titleKey="screen.providers">
  <div class="space-y-6 py-4">
    <PageHeader title={ta('screen.providers')} subtitle="Approve or reject hosts who have signed up." />
    <nav aria-label="Provider list" class="flex flex-wrap gap-2">
      {tabs.map(([key, label]) => (
        <a href={`/admin/providers?show=${key}`} data-testid={`tab-${key}`} aria-current={filter === key ? 'page' : undefined} class={`inline-flex min-h-10 items-center gap-2 rounded-lg px-4 font-medium ${filter === key ? 'bg-primary text-primary-foreground' : 'bg-muted text-foreground hover:bg-border'}`}>{label} <span class="text-sm opacity-90">{count(key)}</span></a>
      ))}
    </nav>
    {failed && <ErrorState variant="server" locale="en" admin />}
    {!failed && rows.length === 0 && <EmptyState title="Nothing here" body="No providers in this list." />}
    <ul class="space-y-3">
      {rows.map((row) => (
        <li data-testid="provider-row" data-status={row.status}>
          <Card class="flex flex-wrap items-center gap-4 !p-4">
            <Avatar name={row.name.en} size="md" />
            <a href={`/admin/providers/${row.id}`} class="mr-auto min-w-0 hover:underline">
              <span class="block text-lg font-semibold">{row.name.en}</span>
              <span class="block text-sm text-muted-foreground">{t('en', `neighbourhood.${row.neighbourhood}` as never)} · Tier {row.tier}</span>
            </a>
            <Badge variant={row.status === 'approved' ? 'verified' : row.status === 'suspended' || row.status === 'removed' ? 'warning' : 'info'}><span data-testid="row-status">{statusText(row.status)}</span></Badge>
            <div class="flex gap-2">
              {row.status !== 'approved' && (
                <form method="post" action="/admin/providers/act"><input type="hidden" name="intent" value="approve" /><input type="hidden" name="id" value={row.id} /><input type="hidden" name="from" value={here} /><Button type="submit" size="sm" data-testid="approve">Approve</Button></form>
              )}
              {(row.status === 'applied' || row.status === 'vetting' || row.status === 'suspended') && (
                <form method="post" action="/admin/providers/act"><input type="hidden" name="intent" value="reject" /><input type="hidden" name="id" value={row.id} /><input type="hidden" name="from" value={here} /><Button type="submit" size="sm" variant="outline" data-testid="reject">Reject</Button></form>
              )}
              {row.status === 'approved' && (
                <form method="post" action="/admin/providers/act"><input type="hidden" name="intent" value="suspend" /><input type="hidden" name="id" value={row.id} /><input type="hidden" name="from" value={here} /><Button type="submit" size="sm" variant="outline" data-testid="suspend">Suspend</Button></form>
              )}
            </div>
          </Card>
        </li>
      ))}
    </ul>
  </div>
</AdminShell>
