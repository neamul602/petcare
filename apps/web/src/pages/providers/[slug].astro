---
import { t, type MessageKey } from '@petcare/shared/i18n';
import { formatMoney } from '@petcare/shared/locale';
import Avatar from '@/components/kit/Avatar.astro';
import Badge from '@/components/kit/Badge.astro';
import Button from '@/components/kit/Button.astro';
import Card from '@/components/kit/Card.astro';
import OwnerShell from '@/layouts/OwnerShell.astro';
import { apiFetch } from '@/lib/api';
import { formatDate } from '@petcare/shared/locale';
import { getLocale } from '@/lib/locale';
const locale = getLocale(Astro.cookies);
const response = await apiFetch(`/providers/${Astro.params.slug}`, { cookie: Astro.request.headers.get('cookie') }).catch(() => null);
if (!response || response.status === 404) return Astro.rewrite('/404');
if (!response.ok) return Astro.redirect('/search');
const { provider } = (await response.json()) as { provider: any };
const name: string = provider.name[locale];
const revRes = await apiFetch(`/providers/${provider.slug}/reviews`).then((r) => (r.ok ? r.json() : null)).catch(() => null);
const reviewList: any[] = revRes?.reviews ?? [];
const agg = revRes?.aggregates;
const from = Astro.url.searchParams.get('from') ?? '';
const to = Astro.url.searchParams.get('to') ?? '';
let busy: string[] | null = null;
if (from && to) {
  const avail = await apiFetch(`/providers/${provider.slug}/availability?from=${from}&to=${to}`).then((r) => (r.ok ? r.json() : null)).catch(() => null);
  if (avail) busy = (avail.nights as Array<{ date: string; available: boolean }>).filter((n) => !n.available).map((n) => formatDate(new Date(`${n.date}T00:00:00+06:00`), locale));
}
const bookHref = `/book/${provider.slug}${from && to ? `?from=${from}&to=${to}` : ''}`;
const L = (key: string, params?: Record<string, string | number>) => t(locale, key as MessageKey, params);
---
<OwnerShell titleKey="screen.provider">
  <div class="gap-8 py-2 lg:grid lg:grid-cols-[1fr_22rem]">
    <div class="space-y-6">
      <section class="hero-band flex flex-wrap items-center gap-6 rounded-2xl border border-border p-6 md:p-8">
        <Avatar name={name} size="xl" />
        <div class="min-w-0 space-y-2">
          <h1 class="text-3xl font-semibold md:text-4xl" data-testid="provider-title">{name}</h1>
          <p class="text-lg text-muted-foreground">{provider.area[locale]} · {provider.species.map((s: string) => L(`provider.species.${s}`)).join(', ')}</p>
          {provider.tier === 'A' && <Badge variant="tier-a" label={L('provider.badge.tierA.label')}>{L('provider.badge.tierA')}</Badge>}
        </div>
      </section>

      <Card class="space-y-3">
        <h2 class="text-xl font-semibold">{L('provider.experience')}</h2>
        <p class="text-lg leading-relaxed">{provider.experience[locale]}</p>
        <p class="text-muted-foreground">{L('provider.capacity', { n: provider.capacity.smallPets })}</p>
      </Card>

      {provider.capabilities.length > 0 && (
        <Card class="space-y-3">
          <h2 class="text-xl font-semibold">{L('provider.capabilities')}</h2>
          <ul class="flex flex-wrap gap-2">{provider.capabilities.map((c: string) => <li class="rounded-full bg-primary-soft px-4 py-2 text-primary-soft-foreground">✓ {L(`capability.${c}`)}</li>)}</ul>
        </Card>
      )}

      <Card class="space-y-2">
        <h2 class="text-xl font-semibold">{L('provider.photos')}</h2>
        {provider.photos.length === 0 && <p class="text-muted-foreground">{L('provider.photos.none')}</p>}
      </Card>

      {reviewList.length === 0
        ? <p data-testid="provider-new" class="rounded-lg bg-muted px-5 py-4">{L('provider.new')}</p>
        : (
          <Card class="space-y-4" data-testid="reviews">
            <h2 class="text-xl font-semibold">{L('provider.reviews')}</h2>
            <p class="font-medium" data-testid="review-summary">{L('provider.reviews.summary', { avg: agg.average, count: agg.count })} · {L('provider.reviews.photosShare', { pct: agg.withPhotosPercent })}</p>
            <ul class="space-y-4">
              {reviewList.map((r) => (
                <li class="space-y-2 border-t border-border pt-4" data-testid="review">
                  <p class="flex items-center gap-3"><span class="text-lg tracking-widest text-warning" aria-hidden="true">{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</span><strong>{r.rating}/5</strong> <span class="rounded-full bg-primary-soft px-3 py-1 text-sm text-primary-soft-foreground">{L('review.verified')}</span></p>
                  {r.text && <p class="leading-relaxed">{r.text}</p>}
                  {r.photos.length > 0 && <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4">{r.photos.map((src: string) => <li><img src={src} alt="" loading="lazy" class="aspect-square w-full rounded-lg object-cover" /></li>)}</ul>}
                </li>
              ))}
            </ul>
          </Card>
        )}
    </div>

    <aside class="mt-6 lg:mt-0">
      <Card variant="elevated" class="space-y-4 lg:sticky lg:top-24">
        <p class="font-serif text-3xl font-semibold text-primary" data-testid="provider-price">{provider.pricePerNightPoisha === null ? L('provider.priceMissing') : L('provider.price', { price: formatMoney(provider.pricePerNightPoisha) })}</p>
        {busy && (
          <div class="space-y-1 rounded-md bg-muted p-4" data-testid="availability">
            <h2 class="font-semibold">{L('provider.availability')}</h2>
            <p>{busy.length === 0 ? L('provider.availability.all') : L('provider.availability.some', { dates: busy.join(', ') })}</p>
          </div>
        )}
        <Button href={bookHref} size="lg" class="w-full" data-testid="book-button">{L('provider.book', { name })}</Button>
      </Card>
    </aside>
  </div>
</OwnerShell>
