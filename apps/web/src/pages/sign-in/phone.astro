---
import { MESSAGE_KEYS, t, type MessageKey } from '@petcare/shared/i18n';
import { platformRules } from '@petcare/shared/config';
import SignInFlow from '@/components/auth/SignInFlow.tsx';
import Card from '@/components/kit/Card.astro';
import OwnerShell from '@/layouts/OwnerShell.astro';
import { getLocale } from '@/lib/locale';

const locale = getLocale(Astro.cookies);
const requested = Astro.url.searchParams.get('next') ?? '/';
const next = requested.startsWith('/') && !requested.startsWith('//') ? requested : '/';
// Only the sign-in strings are sent to the browser, already translated.
const text: Record<string, string> = Object.fromEntries(MESSAGE_KEYS.filter((key) => key.startsWith('signin.')).map((key) => [key, t(locale, key)]));
const neighbourhoods = platformRules.launchNeighbourhoods.map((id) => ({ id, label: t(locale, `neighbourhood.${id}` as MessageKey) }));
---
<OwnerShell titleKey="signin.title" showTabs={false}>
  <section data-screen="O2" class="mx-auto max-w-md pt-4">
    <Card><SignInFlow client:load next={next} resendAfterSeconds={platformRules.auth.resendAfterSeconds} neighbourhoods={neighbourhoods} text={text} /></Card>
  </section>
</OwnerShell>
