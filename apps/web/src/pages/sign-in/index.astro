---
import Card from '@/components/kit/Card.astro';
import Button from '@/components/kit/Button.astro';
import PetArt from '@/components/kit/PetArt.astro';
import OwnerShell from '@/layouts/OwnerShell.astro';
import { apiFetch, copyCookies } from '@/lib/api';

export const prerender = false;
const requested = Astro.url.searchParams.get('next') ?? '/';
const next = requested.startsWith('/') && !requested.startsWith('//') ? requested : '/';
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const response = await apiFetch('/auth/signin', {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ email: String(form.get('email') ?? ''), password: String(form.get('password') ?? '') }),
  }).catch(() => null);
  if (response?.ok) {
    const { redirect, role } = (await response.json()) as { redirect: string; role: string };
    const headers = new Headers({ location: role === 'owner' ? next : redirect });
    copyCookies(response, headers);
    return new Response(null, { status: 303, headers });
  }
  error = response ? ((await response.json()).error?.message ?? 'Could not sign in') : 'PetCare could not be reached';
}
const input = 'h-12 w-full rounded-md border border-border bg-input px-4 text-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring';
---
<OwnerShell titleKey="signin.title" showTabs={false}>
  <section data-screen="O2" class="mx-auto grid max-w-5xl items-center gap-8 pt-4 md:grid-cols-2">
    <aside class="hidden rounded-3xl bg-primary p-10 text-primary-foreground shadow-xl md:flex md:flex-col md:justify-center md:gap-6">
      <PetArt class="mx-auto w-full max-w-sm" />
      <p class="text-center font-serif text-2xl font-semibold">Trusted home care for your pet.</p>
    </aside>

    <Card>
      <h1 class="text-2xl font-semibold">Sign in</h1>
      <p class="mt-1 text-muted-foreground">Welcome back. Sign in to book, manage pets or run your provider account.</p>
      {error && <p role="alert" data-testid="signin-email-error" class="mt-4 rounded-md bg-destructive-soft px-4 py-3 text-destructive">{error}</p>}
      <form method="post" class="mt-5 space-y-4">
        <label class="block"><span class="mb-1 block text-sm font-medium">Email</span><input class={input} type="email" name="email" required autocomplete="email" data-testid="email" /></label>
        <label class="block"><span class="mb-1 block text-sm font-medium">Password</span><input class={input} type="password" name="password" required autocomplete="current-password" data-testid="password" /></label>
        <Button type="submit" class="w-full" data-testid="signin-submit">Sign in</Button>
      </form>
      <p class="mt-5 text-sm text-muted-foreground">New to PetCare? <a class="font-medium text-primary underline" href={`/sign-up?next=${encodeURIComponent(next)}`} data-testid="to-sign-up">Create an account</a> · <a class="font-medium text-primary underline" href={`/sign-in/phone?next=${encodeURIComponent(next)}`}>Use a phone code instead</a></p>
    </Card>
  </section>
</OwnerShell>
