---
/**
 * Development-only gallery of the UI kit for design review (not a product screen, so its
 * labels are not translated). Returns 404 outside development.
 */
import Badge from '@/components/kit/Badge.astro';
import Button from '@/components/kit/Button.astro';
import Card from '@/components/kit/Card.astro';
import Chip from '@/components/kit/Chip.astro';
import EmptyState from '@/components/states/EmptyState.astro';
import ErrorState from '@/components/states/ErrorState.astro';
import LoadingState from '@/components/states/LoadingState.astro';
import Input from '@/components/kit/Input.astro';
import Sheet from '@/components/kit/Sheet.tsx';
import StatePill from '@/components/kit/StatePill.astro';
import StickyActionBar from '@/components/kit/StickyActionBar.astro';
import Toggle from '@/components/kit/Toggle.tsx';
import BaseLayout from '@/layouts/BaseLayout.astro';

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 });
}
const states = ['requested', 'authorized', 'captured', 'in-stay', 'completed', 'declined', 'disputed', 'refunded', 'payout-released', 'payout-pending', 'payout-frozen', 'payout-hold'] as const;
---
<BaseLayout title="UI kit · PetCare" lang="en" skipLabel="Skip to content" offlineMessage="Offline. Bookings will be sent when you're back online.">
  <main id="main" class="mx-auto max-w-4xl space-y-8 px-4 py-8">
    <h1 class="font-serif text-4xl font-semibold">PetCare UI kit</h1>
    <Card class="space-y-4">
      <h2 class="text-xl font-semibold">Buttons</h2>
      <div class="flex flex-wrap gap-3">
        <Button>Primary</Button><Button variant="secondary">Secondary</Button><Button variant="outline">Outline</Button>
        <Button variant="ghost">Ghost</Button><Button variant="destructive">Destructive</Button><Button variant="link">Link</Button>
        <Button size="sm">Small</Button><Button size="lg">Large</Button><Button disabled>Disabled</Button>
      </div>
    </Card>
    <Card class="space-y-4">
      <h2 class="text-xl font-semibold">Badges and state pills</h2>
      <div class="flex flex-wrap gap-2">
        <Badge variant="tier-a" label="Tier-A provider, admin-vetted">Tier-A · Admin-vetted</Badge>
        <Badge variant="verified">Verified</Badge><Badge variant="acute">Acute event</Badge>
        <Badge variant="warning">Warning</Badge><Badge variant="info">Info</Badge><Badge>Neutral</Badge><Badge variant="decline">Declined</Badge>
      </div>
      <div class="flex flex-wrap gap-2">{states.map((s) => <StatePill state={s} label={s} />)}</div>
    </Card>
    <Card class="space-y-4">
      <h2 class="text-xl font-semibold">Chips and toggle</h2>
      <div class="flex flex-wrap gap-3"><Chip selected>Gulshan</Chip><Chip>Banani</Chip><Chip>Baridhara</Chip></div>
      <Toggle client:load label="Use saved care plan" defaultChecked />
    </Card>
    <Card class="space-y-4">
      <h2 class="text-xl font-semibold">Form persistence</h2>
      <form data-persist="kit-demo" class="space-y-4">
        <Input id="persist-note" name="note" label="Typed text is kept on this device" />
        <Input id="persist-secret" name="secret" type="password" label="Passwords are never kept" />
      </form>
    </Card>
    <Card class="space-y-4">
      <h2 class="text-xl font-semibold">Inputs</h2>
      <Input id="kit-name" label="Pet name" required hint="As you call them at home" />
      <Input id="kit-weight" label="Weight (kg)" type="number" error="Enter a weight above 0" />
      <Input id="kit-notes" label="Instructions" multiline />
    </Card>
    <Card class="space-y-4">
      <h2 class="text-xl font-semibold">Sheet</h2>
      <Sheet client:load triggerLabel="Open sheet" title="Example sheet" closeLabel="Close"><p>Sheet content.</p></Sheet>
    </Card>
    <Card class="space-y-4">
      <h2 class="text-xl font-semibold">Shared states</h2>
      <LoadingState label="Loading…" rows={2} />
      <EmptyState title="Nothing here yet" body="Your stays will appear here." actionLabel="Find care" actionHref="/" />
      <ErrorState variant="network" locale="en" />
      <ErrorState variant="server" locale="en" />
      <ErrorState variant="permission" locale="en" />
      <ErrorState variant="offline" locale="en" />
    </Card>
    <StickyActionBar>
      <span slot="summary">৳20,000 · 8 nights</span>
      <Button>Continue</Button>
    </StickyActionBar>
  </main>
</BaseLayout>
