---
import { trainingDecisions } from '@petcare/shared/config';
import { t } from '@petcare/shared/i18n';
import BookFlow from '@/components/book/BookFlow';
import OwnerShell from '@/layouts/OwnerShell.astro';
import { apiFetch } from '@/lib/api';
import { todayInDhaka } from '@/lib/dates';
import { getLocale } from '@/lib/locale';
import { textFor } from '@/lib/text';
const locale = getLocale(Astro.cookies);
const cookie = Astro.request.headers.get('cookie');
const res = await apiFetch(`/providers/${Astro.params.providerSlug}`, { cookie }).catch(() => null);
if (!res || res.status === 404) return Astro.rewrite('/404');
if (!res.ok) return Astro.redirect('/search');
const { provider } = (await res.json()) as { provider: any };
const petsRes = await apiFetch('/owner/pets', { cookie }).catch(() => null);
const pets = petsRes?.ok ? ((await petsRes.json()) as { pets: Array<{ id: string; name: string; species: string }> }).pets : [];
const q = Astro.url.searchParams;
const name: string = provider.name[locale];
---
<OwnerShell titleKey="screen.book" showTabs={false}>
  <div class="space-y-4 py-4">
    <h1 class="text-2xl font-semibold">{t(locale, 'book.title', { name })}</h1>
    <BookFlow
      client:load
      provider={{ slug: provider.slug, name, pricePerNightPoisha: provider.pricePerNightPoisha ?? 0, species: provider.species }}
      pets={pets}
      initial={{ from: q.get('from') ?? '', to: q.get('to') ?? '', petId: '' }}
      methods={[...trainingDecisions.paymentMethods]}
      today={todayInDhaka()}
      text={textFor(locale, 'book.', 'pay.', 'search.from', 'search.to', 'pets.species.')}
    />
  </div>
</OwnerShell>
