---
import { t } from '@petcare/shared/i18n';
import Button from '@/components/kit/Button.astro';
import Card from '@/components/kit/Card.astro';
import OwnerShell from '@/layouts/OwnerShell.astro';
import { getLocale } from '@/lib/locale';
const locale = getLocale(Astro.cookies);
Astro.response.status = 404;
---
<OwnerShell titleKey="notFound.title" showTabs={false}>
  <section data-screen="not-found" class="space-y-4">
    <h1 class="text-2xl font-semibold">{t(locale, 'notFound.title')}</h1>
    <Card variant="muted" class="space-y-4">
      <p class="text-muted-foreground">{t(locale, 'notFound.body')}</p>
      <Button href="/">{t(locale, 'notFound.action')}</Button>
    </Card>
  </section>
</OwnerShell>
