{
  "name": "petcare",
  "private": true,
  "description": "PetCare v1: curated pet-boarding marketplace for urban Dhaka (training build, AI-DLC)",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,dummy -c green,blue,magenta \"npm run dev -w @petcare/web\" \"npm run dev -w @petcare/api\" \"npm run dev -w @petcare/dummy-services\"",
    "build": "npm run build -w @petcare/web && node scripts/build-sw.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "npm run db:migrate -w @petcare/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:config": "node scripts/check-config-literals.mjs",
    "check:web-ports": "node scripts/check-no-dummy-in-web.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "checks": "npm run check:i18n && npm run check:config && npm run check:web-ports && npm run check:contrast",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run checks && npm run test",
    "start:web": "node apps/web/dist/server/entry.mjs",
    "seed": "npm run seed -w @petcare/api --",
    "seed:demo": "npm run seed:demo -w @petcare/api"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "fs-extra": "^11.4.1",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1"
  }
}
